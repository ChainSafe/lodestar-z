{
  "name": "@chainsafe/lodestar-z",
  "version": "1.1.0",
  "description": "Lodestar-z NAPI bindings",
  "files": [
    "bindings/src/",
    "docs/leveldb.md",
    "src/leveldb/LICENSE",
    "zig-out/lib/",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./bindings/src/index.js",
      "types": "./bindings/src/index.d.ts"
    },
    "./network": {
      "import": "./bindings/src/network.js",
      "types": "./bindings/src/network.d.ts"
    },
    "./blst": {
      "import": "./bindings/src/blst.js",
      "types": "./bindings/src/blst.d.ts"
    },
    "./bls-verifier": {
      "import": "./bindings/src/bls-verifier.js",
      "types": "./bindings/src/bls-verifier.d.ts"
    },
    "./pubkeys": {
      "import": "./bindings/src/pubkeys.js",
      "types": "./bindings/src/pubkeys.d.ts"
    },
    "./state-transition": {
      "import": "./bindings/src/state-transition.js",
      "types": "./bindings/src/state-transition.d.ts"
    },
    "./metrics": {
      "import": "./bindings/src/metrics.js",
      "types": "./bindings/src/metrics.d.ts"
    },
    "./shuffle": {
      "import": "./bindings/src/shuffle.js",
      "types": "./bindings/src/shuffle.d.ts"
    },
    "./leveldb": {
      "types": "./bindings/src/leveldb.d.ts",
      "import": "./bindings/src/leveldb.js"
    }
  },
  "scripts": {
    "prepare": "pnpm run prepare-${LODESTAR_PRESET:-mainnet}",
    "prepare-mainnet": "zig build build-lib:bindings -Doptimize=ReleaseSafe -Dpreset=mainnet",
    "prepare-minimal": "zig build build-lib:bindings -Doptimize=ReleaseSafe -Dpreset=minimal",
    "lint": "biome check",
    "test:network-interop": "zig build build-exe:network_interop_peer -Doptimize=ReleaseSafe && node --max-old-space-size=256 test/interop/run.mjs zig-out/bin/network_interop_peer",
    "test:network-core-interop": "zig build build-exe:core_interop_peer -Doptimize=ReleaseSafe && node --max-old-space-size=256 test/interop/core_run.mjs",
    "test:network-identify-interop": "zig build build-exe:network_interop_peer -Doptimize=ReleaseSafe && node --max-old-space-size=256 test/interop/identify_run.mjs zig-out/bin/network_interop_peer installed",
    "test": "NODE_OPTIONS='--expose-gc' vitest run bindings/test/*.test.ts",
    "benchmark": "NODE_OPTIONS='--import tsx' benchmark 'bindings/perf/**/*.test.ts' --isolate --config .benchrc.yaml --defaultBranch main",
    "typecheck:network": "tsc -p tsconfig.network.json",
    "typecheck:leveldb": "tsc -p tsconfig.leveldb.json"
  },
  "keywords": [],
  "author": "ChainSafe Systems",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChainSafe/lodestar-z.git"
  },
  "packageManager": "pnpm@10.24.0",
  "zapi": {
    "binaryName": "bindings",
    "step": "build-lib:bindings",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "dependencies": {
    "@chainsafe/zapi": "4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@chainsafe/benchmark": "2.1.0",
    "@chainsafe/biomejs-config": "^1.0.0",
    "@chainsafe/fast-crc32c": "4.2.0",
    "@chainsafe/libp2p-quic": "2.1.3",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/gossipsub": "17.1.1",
    "@libp2p/identify": "4.1.14",
    "@libp2p/peer-id": "6.0.15",
    "@lodestar/config": "^1.39.1",
    "@lodestar/era": "^1.39.1",
    "@lodestar/reqresp": "1.46.0",
    "@lodestar/state-transition": "^1.39.1",
    "@lodestar/types": "^1.39.1",
    "@multiformats/multiaddr": "13.0.3",
    "@types/node": "^25.0.9",
    "it-length-prefixed": "11.0.1",
    "libp2p": "3.3.10",
    "snappy": "7.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.17"
  }
}
