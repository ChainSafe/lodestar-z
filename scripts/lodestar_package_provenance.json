  "install": {
    "files": ["bindings/src/", "zig-out/lib/", "THIRD_PARTY_NOTICES.txt"],
    "legal": ["THIRD_PARTY_NOTICES.txt"],
    "embedded": {
      "addon": "zig-out/lib/bindings.node",
      "reviewed": {
        "build": "zig build build-lib:bindings -Doptimize=ReleaseSafe -Dpreset=<preset> -Dtarget=<zig target> -Dcpu=<cpu>",
        "pack": "node scripts/lodestar_package.mjs pack",
        "install": "node scripts/lodestar_package.mjs install",
        "loader": "zapi requireNapiLibrary loads the package's zig-out/lib addon"
      }
    },
    "platform": {
      "targets": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ],
      "runner": "ubuntu-22.04",
      "workflows": {
        ".github/workflows/bindings-platforms.yml": [
          "pnpm install --frozen-lockfile --ignore-scripts",
          "scripts/zig-cross.sh pnpm zapi build-artifacts --optimize ReleaseSafe",
          "node scripts/release_artifacts.mjs record",
          "node scripts/check_network_package.mjs --lifecycle",
          "pnpm zapi prepublish",
          "node scripts/lodestar_package.mjs notices --package-dir .",
          "node scripts/release_artifacts.mjs verify --qualification qualification"
        ],
        ".github/workflows/publish-bindings.yml": [
          "pnpm install --frozen-lockfile --ignore-scripts",
          "pnpm zapi prepublish",
          "node scripts/lodestar_package.mjs notices --package-dir .",
          "node scripts/release_artifacts.mjs verify --qualification qualification",
          "rm -rf zig-out/lib",
          "--ignore-scripts --provenance"
        ],
        ".github/workflows/publish-dev-bindings.yml": [
          "pnpm install --frozen-lockfile --ignore-scripts",
          "pnpm zapi prepublish",
          "node scripts/lodestar_package.mjs notices --package-dir .",
          "node scripts/release_artifacts.mjs verify --qualification qualification",
          "rm -rf zig-out/lib",
          "--ignore-scripts --provenance"
        ]
      },
      "reviewed": {
        "addon": "artifacts/<target>/bindings.node from the release build, recorded in artifacts/build.json, qualified on its platform and published from there",
        "loader": "zapi requireNapiLibrary loads @chainsafe/lodestar-z-<target> when the package has no zig-out/lib addon"
      }
    }
  }
