 // Returns the stream's send capacity in bytes.
 ssize_t quiche_conn_stream_capacity(quiche_conn *conn, uint64_t stream_id);
 
+typedef struct {
+    // The active path's congestion window less its bytes in flight, or SIZE_MAX
+    // while probes are due.
+    size_t cwnd_available;
+
+    // The connection's send capacity: the lesser of the congestion window
+    // available and the connection credit when last updated, less stream data
+    // buffered since.
+    size_t tx_cap;
+
+    // The peer's connection flow control limit less the stream data buffered.
+    uint64_t connection_credit;
+
+    // The peer's flow control limit for the stream less the data buffered on it.
+    uint64_t stream_credit;
+
+    // Bytes buffered on the stream awaiting transmission, retransmissions
+    // included.
+    uint64_t stream_unsent;
+} quiche_send_capacity;
+
+// Reads the parts of a stream's send capacity without changing any state.
+int quiche_conn_send_capacity(const quiche_conn *conn, uint64_t stream_id,
+                              quiche_send_capacity *out);
+
 // Returns true if the stream has data that can be read.
 bool quiche_conn_stream_readable(const quiche_conn *conn, uint64_t stream_id);
 
