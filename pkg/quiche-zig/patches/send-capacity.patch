+#[repr(C)]
+pub struct SendCapacity {
+    cwnd_available: size_t,
+    tx_cap: size_t,
+    connection_credit: u64,
+    stream_credit: u64,
+    stream_unsent: u64,
+}
+
+#[no_mangle]
+pub extern "C" fn quiche_conn_send_capacity(
+    conn: &Connection, stream_id: u64, out: &mut SendCapacity,
+) -> c_int {
+    use crate::recovery::RecoveryOps;
+
+    let stream = match conn.streams.get(stream_id) {
+        Some(v) => v,
+
+        None => return Error::InvalidStreamState(stream_id).to_c() as c_int,
+    };
+
+    let stream_credit = match stream.send.cap() {
+        Ok(v) => v as u64,
+
+        Err(e) => return e.to_c() as c_int,
+    };
+
+    out.cwnd_available = match conn.paths.get_active() {
+        Ok(p) => p.recovery.cwnd_available(),
+
+        Err(_) => 0,
+    };
+    out.tx_cap = conn.tx_cap;
+    out.connection_credit = conn.max_tx_data.saturating_sub(conn.tx_data);
+    out.stream_credit = stream_credit;
+    out.stream_unsent =
+        stream.send.off_back().saturating_sub(stream.send.off_front());
+
+    0
+}
+
 #[no_mangle]
